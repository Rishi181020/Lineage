LINEAGE_REGION=us-east-1
# Optional: pin a Bedrock inference profile. Otherwise the app lists what your account has.
LINEAGE_MODEL_ID=
STAGING_REAL_TOKEN=lineage_demo_real_staging_token
# Folder agents work on. Each agent gets a private copy, so this folder isn't changed.
# LINEAGE_WORKSPACE=C:/path/to/your/project
# Where your AWS credentials live, if not in ~/.aws
# AWS_CONFIG_DIR=C:/Users/you/.aws
